+
+
+# 豆瓣图片代理，规避图片防盗链
+@App.route('/img_proxy', methods=['GET'])
+def img_proxy():
+    """
+    代理豆瓣图床图片，请求时自动携带豆瓣防盗链Referer
+    """
+    url = request.args.get("url", "")
+    if not url:
+        return make_response("", 404)
+    # 仅代理豆瓣图床图片，防止SSRF
+    if not ImageUtils.is_douban_image(url):
+        return make_response("", 403)
+    r = ImageUtils.get_image_res(url, proxies=Config().get_proxies())
+    if r is None or r.status_code != 200:
+        return make_response("", 404)
+    resp = make_response(r.content)
+    resp.headers['Content-Type'] = r.headers.get('Content-Type', 'image/jpeg')
+    resp.headers['Cache-Control'] = 'public, max-age=604800'
+    return resp
