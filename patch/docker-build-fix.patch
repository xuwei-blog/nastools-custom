diff -ruN a/docker/Dockerfile b/docker/Dockerfile
--- a/docker/Dockerfile	2026-09-07 17:09:00.552600700 +0800
+++ b/docker/Dockerfile	2026-09-07 17:09:29.641364300 +0800
@@ -1,6 +1,8 @@
 FROM alpine
+# 从本地拷贝依赖清单（原 jxxghp/nas-tools 仓库已不可在线获取）
+COPY package_list.txt requirements.txt /tmp/
 RUN apk add --no-cache libffi-dev \
-    && apk add --no-cache $(echo $(wget --no-check-certificate -qO- https://raw.githubusercontent.com/jxxghp/nas-tools/master/package_list.txt)) \
+    && apk add --no-cache $(cat /tmp/package_list.txt) \
     && ln -sf /usr/share/zoneinfo/${TZ} /etc/localtime \
     && echo "${TZ}" > /etc/timezone \
     && ln -sf /usr/bin/python3 /usr/bin/python \
@@ -10,18 +12,18 @@
     && chmod +x /usr/bin/mc \
     && pip install --upgrade pip setuptools wheel \
     && pip install cython \
-    && pip install -r https://raw.githubusercontent.com/jxxghp/nas-tools/master/requirements.txt \
+    && pip install -r /tmp/requirements.txt \
     && apk del libffi-dev \
     && npm install pm2 -g \
     && rm -rf /tmp/* /root/.cache /var/cache/apk/*
 ENV LANG="C.UTF-8" \
     TZ="Asia/Shanghai" \
     NASTOOL_CONFIG="/config/config.yaml" \
-    NASTOOL_AUTO_UPDATE=true \
+    NASTOOL_AUTO_UPDATE=false \
     NASTOOL_CN_UPDATE=true \
     NASTOOL_VERSION=master \
     PS1="\u@\h:\w \$ " \
-    REPO_URL="https://github.com/jxxghp/nas-tools.git" \
+    REPO_URL="https://github.com/NAStool/nas-tools.git" \
     PYPI_MIRROR="https://pypi.tuna.tsinghua.edu.cn/simple" \
     ALPINE_MIRROR="mirrors.ustc.edu.cn" \
     PUID=0 \
@@ -33,9 +35,18 @@
     && echo "${WORKDIR}/" > /usr/lib/python${python_ver%.*}/site-packages/nas-tools.pth \
     && echo 'fs.inotify.max_user_watches=524288' >> /etc/sysctl.conf \
     && echo 'fs.inotify.max_user_instances=524288' >> /etc/sysctl.conf \
-    && git config --global pull.ff only \
-    && git clone -b master ${REPO_URL} ${WORKDIR} --depth=1 --recurse-submodule \
-    && git config --global --add safe.directory ${WORKDIR}
+    && git config --global pull.ff only
+# 拷贝本地源码替代 git clone（原仓库已不可在线获取）
+COPY app ${WORKDIR}/app
+COPY web ${WORKDIR}/web
+COPY config ${WORKDIR}/config
+COPY docker ${WORKDIR}/docker
+COPY db_scripts ${WORKDIR}/db_scripts
+COPY third_party ${WORKDIR}/third_party
+COPY run.py config.py log.py version.py check_config.py build_sites.py dbscript_gen.py ${WORKDIR}/
+COPY requirements.txt third_party.txt package_list.txt douban-image-fix.patch ${WORKDIR}/
+# 应用豆瓣图片防盗链修复补丁
+RUN cd ${WORKDIR} && git apply douban-image-fix.patch && rm -f douban-image-fix.patch
 EXPOSE 3000
 VOLUME ["/config"]
 ENTRYPOINT ["/nas-tools/docker/entrypoint.sh"]
\ No newline at end of file
