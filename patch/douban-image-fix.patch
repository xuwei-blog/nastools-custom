diff -ruN a/app/utils/image_utils.py b_base/app/utils/image_utils.py
--- a/app/utils/image_utils.py	1970-01-01 08:00:00.000000000 +0800
+++ b_base/app/utils/image_utils.py	2026-09-08 16:23:46.322387100 +0800
@@ -0,0 +1,48 @@
+from urllib.parse import quote, urlparse
+
+from app.utils.http_utils import RequestUtils
+
+# 豆瓣图床图片域名
+DOUBAN_IMAGE_HOST = "doubanio.com"
+# 豆瓣图床图片防盗链Referer
+DOUBAN_IMAGE_REFERER = "https://movie.douban.com/"
+
+
+class ImageUtils:
+
+    @staticmethod
+    def is_douban_image(url):
+        """
+        判断是否为豆瓣图床图片地址
+        :param url: 图片地址
+        """
+        if not url:
+            return False
+        try:
+            host = urlparse(url).hostname or ""
+        except Exception:
+            return False
+        return host.endswith(DOUBAN_IMAGE_HOST)
+
+    @staticmethod
+    def trans_douban_image(url, domain=""):
+        """
+        将豆瓣图床图片地址转换为本地图片代理地址，规避防盗链
+        :param url: 图片地址
+        :param domain: 本机外网访问地址，未配置时返回原地址
+        """
+        if not ImageUtils.is_douban_image(url) or not domain:
+            return url
+        domain = domain.rstrip("/")
+        return f"{domain}/img_proxy?url={quote(url, safe='')}"
+
+    @staticmethod
+    def get_image_res(url, proxies=False):
+        """
+        下载图片，豆瓣图床图片自动携带防盗链Referer
+        :param url: 图片地址
+        :param proxies: 是否使用代理服务器
+        """
+        if ImageUtils.is_douban_image(url):
+            return RequestUtils(referer=DOUBAN_IMAGE_REFERER, proxies=proxies).get_res(url)
+        return RequestUtils(proxies=proxies).get_res(url)
