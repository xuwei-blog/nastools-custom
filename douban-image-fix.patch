diff -ruN a/app/utils/image_utils.py b/app/utils/image_utils.py
--- a/app/utils/image_utils.py	1970-01-01 08:00:00.000000000 +0800
+++ b/app/utils/image_utils.py	2026-09-08 15:16:11.618576300 +0800
@@ -0,0 +1,70 @@
+import re
+from urllib.parse import quote, urlparse
+
+from app.utils.http_utils import RequestUtils
+
+# 豆瓣图床图片域名
+DOUBAN_IMAGE_HOST = "doubanio.com"
+# 豆瓣图床图片防盗链Referer
+DOUBAN_IMAGE_REFERER = "https://movie.douban.com/"
+# 豆瓣图床CDN域名，老域名带Referer可正常访问
+DOUBAN_IMAGE_CDN_HOST = "img1.doubanio.com"
+
+
+class ImageUtils:
+
+    @staticmethod
+    def __trans_image_url(url):
+        """
+        将豆瓣图床新签名域名转换为老CDN域名，
+        新签名域名直接访问只会返回占位内容，老CDN域名带Referer可正常获取图片
+        :param url: 图片地址
+        """
+        if not url:
+            return url
+        try:
+            parsed = urlparse(url)
+            host = parsed.hostname or ""
+        except Exception:
+            return url
+        if host.endswith(DOUBAN_IMAGE_HOST) and not re.match(r"^img\d+\.", host):
+            return url.replace(host, DOUBAN_IMAGE_CDN_HOST, 1)
+        return url
+
+    @staticmethod
+    def is_douban_image(url):
+        """
+        判断是否为豆瓣图床图片地址
+        :param url: 图片地址
+        """
+        if not url:
+            return False
+        try:
+            host = urlparse(url).hostname or ""
+        except Exception:
+            return False
+        return host.endswith(DOUBAN_IMAGE_HOST)
+
+    @staticmethod
+    def trans_douban_image(url, domain=""):
+        """
+        将豆瓣图床图片地址转换为本地图片代理地址，规避防盗链
+        :param url: 图片地址
+        :param domain: 本机外网访问地址，未配置时返回原地址
+        """
+        if not ImageUtils.is_douban_image(url) or not domain:
+            return url
+        domain = domain.rstrip("/")
+        return f"{domain}/img_proxy?url={quote(url, safe='')}"
+
+    @staticmethod
+    def get_image_res(url, proxies=False):
+        """
+        下载图片，豆瓣图床图片自动转换域名并携带防盗链Referer
+        :param url: 图片地址
+        :param proxies: 是否使用代理服务器
+        """
+        if ImageUtils.is_douban_image(url):
+            url = ImageUtils.__trans_image_url(url)
+            return RequestUtils(referer=DOUBAN_IMAGE_REFERER, proxies=proxies).get_res(url)
+        return RequestUtils(proxies=proxies).get_res(url)
